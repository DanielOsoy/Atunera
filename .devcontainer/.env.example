# Copiar como .devcontainer/.env y poner valores reales. Nunca subir .env a GitHub.
DB_HOST=db
DB_PORT=3306
DB_NAME=industria_atunera
DB_USER=app
DB_PASS=

# Empresa simulada (SQL Server). Mínimo 8 caracteres con mayúsculas, minúsculas y números.
EMPRESA_SA_PASSWORD=
EMPRESA_LECTOR_PASSWORD=

# Base local de prueba industria_atunera_sim (usuario del sincronizador)
LOCAL_SIM_SYNC_PASSWORD=
LOCAL_SIM_APP_PASSWORD=

# Seguridad: base de usuarios y bitácora (auth_app) y reactivación de la sincronización (sync_control)
AUTH_DB_PASSWORD=
SYNC_CONTROL_PASSWORD=
# 1 en el servidor publicado con HTTPS: la cookie de sesión solo viaja cifrada
SESION_COOKIE_SEGURA=0
