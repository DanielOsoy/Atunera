# Imagen de línea de comandos para el generador de datos simulados y el sincronizador.
# Incluye drivers para SQL Server (empresa) y MySQL (copia local).
FROM php:8.2-cli-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg unixodbc-dev $PHPIZE_DEPS \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list -o /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && pecl install pdo_sqlsrv-5.12.0 \
    && docker-php-ext-enable pdo_sqlsrv \
    && docker-php-ext-install pdo_mysql \
    && apt-get purge -y $PHPIZE_DEPS && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

WORKDIR /app
